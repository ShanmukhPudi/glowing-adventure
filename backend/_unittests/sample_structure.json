        { "name": "Authorization", "value": "Bearer your_token_here" }
      ]
    },
    {
      "id": "req-009",
      "colId": "atlantis-001",
      "containerId": "folder-bookings",
      "name": "Create Booking",
      "method": "POST",
      "url": "http://localhost:5000/api/bookings",
      "body": {
        "type": "json",
        "raw": "{\n  \"hotelId\": \"paste_hotel_id_here\",\n  \"roomsBooked\": 2\n}"
      },
      "headers": [
        { "name": "Authorization", "value": "Bearer your_token_here" }
      ]
    },
    {
      "id": "req-010",
      "colId": "atlantis-001",
